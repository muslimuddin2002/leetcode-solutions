class Solution:
    def minBishopMoves(self, source: list[int], target: list[int]) -> int:
        sr, sc = source
        tr, tc = target
        
        if source == target:
            return 0
            
        # Parity check: a bishop can only move to squares of the same color
        if (sr + sc) % 2 != (tr + tc) % 2:
            return -1
            
        # If they are on the same diagonal, it takes 1 move
        if abs(sr - tr) == abs(sc - tc):
            return 1
            
